		annotation SummarizationSetBy = Automatic

	column 'Customer Priority' = IF(('Customer Lookup'[Parent Status]== "Yes") && ('Customer Lookup'[AnnualIncome] >=100000),"Priority","Standard")
		lineageTag: 2773f4fe-e00c-4f7f-8031-5d5d059948e9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Income level' = ```
			IF('Customer Lookup'[AnnualIncome]>=150000,"Very high",
			IF('Customer Lookup'[AnnualIncome]>=100000,"High",
			IF('Customer Lookup'[AnnualIncome]>50000,"Average",
			"Low")))
			
			```
		lineageTag: 600d6ba2-eee5-4fc9-9645-39dfd6fe319b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Education Category' =
			SWITCH(TRUE(), 'Customer Lookup'[EducationLevel] in {"Partial College","Bachelors"},"UG",
			'Customer Lookup'[EducationLevel] in {"High School", "Partial High School"},"High School","PG")
		lineageTag: 634d16d8-2bb0-48b9-a6ea-460e63f02b78
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

